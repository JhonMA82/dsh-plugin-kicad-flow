{
  "name": "dsh-plugin-kicad-flow",
  "version": "0.4.2",
  "description": "Deterministic Circuit IR -> KiCad -> ERC/DRC -> JLCPCB bundle for DeepSeek Harness.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kicad-flow": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate-example": "node dist/cli.js validate examples/rc-filter.ir.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.5.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
